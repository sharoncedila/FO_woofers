@startuml Edit Dog Profile
' Global param
title Edit Dog Profile
autoactivate on

' Global style configuration
skinparam RoundCorner 0
hide footbox

' Sequence participant configuration
actor "Dog Owner" as User
participant "__: EditDogPage__" as Page <<view>>
participant "__:DogService__" as Service
participant "__:Dog__" as Model <<model>>
participant "__:ImageService__" as ImageService
participant "__:DioInstance__" as Dio
participant "__:Image__" as ImageModel <<model>>
participant "__:ImageNetwork__" as Image


' Sequence diagram
User -> Page: build(context)
Page -> Service: retrieveDogProfile(dogId)
Service -> Dio: get /dogs/profile/dog-id/$dogId
Service <-- Dio: response
Service -> Model: ResponseDogProfileModel.fromJson(response)
Service <-- Model: ResponseDogProfileModel
Page <-- Service: ResponseDogProfileModel
User <-- Page: EditDogPage
User -> Page: uploadDogPic(dogId, image)
Page -> ImageService: uploadDogImage(dogId, image)
ImageService -> Dio : post /upload/dog?dog-id=$dogId
ImageService <-- Dio : response
ImageService -> ImageModel: UploadImageResponse.fromJson(response)
ImageService <-- ImageModel: UploadImageResponse
Page <-- ImageService : UploadImageResponse
Page -> Image : ImageNetwork(urlImage, width, height)
Page <-- Image : Image
User -> Page: editDogProfile()
alt Validation is Successful
Page -> Model: EditDogRequest(dogId, dogName, breedName, dateOfBirth, isOpenAdopt, gender, provinceName, vaccination, description, address, image)
Page <-- Model: EditDogRequest
Page -> Service: editDog(request)
Service -> Dio : post /dogs/profile/edit
Service <-- Dio : response
Service -> Model: EditDogResponse.fromJson(response)
Service <-- Model: EditDogResponse
Page <-- Service: EditDogResponse
User <-- Page: DogProfilePage
else Validation Fails
    User <-- Page: show error message
end




@enduml